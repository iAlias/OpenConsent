{
  "name": "openconsent",
  "version": "2.0.1",
  "description": "Lightweight, dependency-free GDPR Consent Management Platform (CMP) with native Google Consent Mode v2 support. Drop-in cookie banner, script blocking, no monthly fees.",
  "main": "dist/openconsent.cjs",
  "module": "dist/openconsent.esm.js",
  "browser": "dist/openconsent.min.js",
  "unpkg": "dist/openconsent.min.js",
  "jsdelivr": "dist/openconsent.min.js",
  "types": "dist/openconsent.d.ts",
  "exports": {
    ".": {
      "types": "./dist/openconsent.d.ts",
      "import": "./dist/openconsent.esm.js",
      "require": "./dist/openconsent.cjs",
      "default": "./dist/openconsent.esm.js"
    },
    "./browser": "./dist/openconsent.min.js",
    "./legacy": "./dist/cmp.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/openconsent.js",
    "dist/openconsent.min.js",
    "dist/openconsent.cjs",
    "dist/openconsent.esm.js",
    "dist/openconsent.d.ts",
    "dist/cmp.min.js",
    "examples",
    "server-side",
    "README.md",
    "LICENSE",
    "GDPR_COMPLIANCE.md"
  ],
  "scripts": {
    "build:iife:dev": "esbuild src/browser.js --bundle --outfile=dist/openconsent.js",
    "build:iife:prod": "esbuild src/browser.js --bundle --minify --outfile=dist/openconsent.min.js",
    "build:legacy": "esbuild src/browser.js --bundle --minify --outfile=dist/cmp.min.js",
    "build:cjs": "esbuild src/core.js --bundle --format=cjs --outfile=dist/openconsent.cjs",
    "build:esm": "esbuild src/index.mjs --bundle --format=esm --outfile=dist/openconsent.esm.js",
    "build": "npm run build:iife:dev && npm run build:iife:prod && npm run build:legacy && npm run build:cjs && npm run build:esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "gdpr",
    "consent",
    "consent-management-platform",
    "cmp",
    "cookie-banner",
    "cookie-consent",
    "cookiebot-alternative",
    "onetrust-alternative",
    "iubenda-alternative",
    "google-consent-mode",
    "consent-mode-v2",
    "gtm",
    "google-tag-manager",
    "privacy",
    "european-accessibility-act",
    "vanilla-javascript",
    "zero-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iAlias/OpenConsent.git"
  },
  "homepage": "https://ialias.github.io/OpenConsent/",
  "bugs": {
    "url": "https://github.com/iAlias/OpenConsent/issues"
  },
  "author": "Antonino Di Stefano",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
